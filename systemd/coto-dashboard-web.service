[Unit]
Description=Panel web del carrito Coto para Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/.hermes/.env
ExecStart=/usr/bin/python3 %h/.hermes/scripts/coto_dashboard_web.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coto-dashboard-web

[Install]
WantedBy=default.target
